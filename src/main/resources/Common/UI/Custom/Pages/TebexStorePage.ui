$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1340, Height: 820);

  #Title {
    Group {
      LayoutMode: Center;
      Anchor: (Full: 0);

      $C.@Title {
        @Text = "TEBEX STORE";
        Anchor: (Width: 360);
      }
    }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Full: 18);

    Group {
      Anchor: (Width: 930, Right: 18);
      LayoutMode: Top;

      Group #HeaderTitleSlot {
        Anchor: (Bottom: 4);
      }

      Group #HeaderSubtitleSlot {
        Anchor: (Bottom: 16);
      }

      Group {
        Anchor: (Height: 590);
        Padding: (Full: 14);
        Background: #08111b(0.34);

        Group #CategoryGrid {
          LayoutMode: Top;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 14);

        Group #FooterLeftButtonSlot {
          Anchor: (Width: 456, Right: 10);
        }

        Group #FooterRightButtonSlot {
          Anchor: (Width: 456);
        }
      }
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Full: 14);
        Background: #08111b(0.34);

        Group #DetailCardSlot {
          FlexWeight: 1;
        }
      }

      Group #DetailPrimaryButtonSlot {
        Anchor: (Top: 12);
      }

      Group #DetailSecondaryButtonSlot {
        Anchor: (Top: 8);
      }
    }
  }
}
