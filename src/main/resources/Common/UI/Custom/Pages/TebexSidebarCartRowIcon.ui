$C = "../Common.ui";

Group #Row {
  Anchor: (Height: 56, Bottom: 10);
  LayoutMode: Left;
  Padding: (Left: 10, Top: 11, Right: 10, Bottom: 11);
  Background: #08111b(0.82);

  Group {
    Anchor: (Width: 32, Height: 34, Right: 10);
    LayoutMode: Center;

    ItemSlot #ItemIcon {
      Anchor: (Width: 32, Height: 32);
      ShowQuantity: false;
    }
  }

  Group {
    FlexWeight: 1;
    Anchor: (Height: 34, Right: 8);
    LayoutMode: Center;
    Padding: (Top: 10);

    Label #PackageName {
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: $C.@ColorDefault
      );
      Text: "Package";
    }
  }

  $C.@SecondaryTextButton #DecrementButton {
    @Anchor = (Width: 34, Height: 34, Right: 6);
    @Text = "-";
  }

  Group #QuantityBadge {
    Anchor: (Width: 40, Height: 34, Right: 6);
    LayoutMode: Center;
    Padding: (Top: 10);
    Background: #111b28(0.95);

    Label #QuantityLabel {
      Anchor: (Full: 0);
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: $C.@ColorDefault,
        HorizontalAlignment: Center
      );
      Text: "1";
    }
  }

  $C.@SecondaryTextButton #IncrementButton {
    @Anchor = (Width: 34, Height: 34, Right: 8);
    @Text = "+";
  }

  Group {
    Anchor: (Width: 92, Height: 34);
    LayoutMode: Center;
    Padding: (Top: 10);

    Label #PriceLabel {
      Style: (
        FontSize: 15,
        RenderBold: true,
        TextColor: $C.@ColorGoldHighlight
      );
      Text: "0.00 USD";
    }
  }
}
