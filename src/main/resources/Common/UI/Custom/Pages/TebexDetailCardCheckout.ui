$C = "../Common.ui";

Group #Card {
  LayoutMode: Top;
  Padding: (Full: 16);
  Background: #102034(0.92);

  Label #SubcommandName {
    Style: (
      FontSize: 22,
      RenderBold: true,
      TextColor: $C.@ColorDefault,
      RenderUppercase: true
    );
    Anchor: (Bottom: 6);
  }

  Label #SubcommandUsage {
    Style: (
      FontSize: 15,
      RenderBold: true,
      TextColor: $C.@ColorGoldHighlight
    );
    Anchor: (Bottom: 10);
  }

  Label #SubcommandDescription {
    Style: (
      FontSize: 14,
      TextColor: $C.@ColorDefaultLabel,
      Wrap: true
    );
  }
}
